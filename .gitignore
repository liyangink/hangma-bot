# Python 构建与测试产物
.venv/
.uv-cache/
.uv-python/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
*.so
*.pyd
*.dylib
# 类型与覆盖率工具缓存
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# 经过清单与源码摘要校验的共享制品允许入库；开发目录产物仍忽略。
!prebuilt/hangma/**/*.so
dist/
build/
# 本地运行产物与私有配置（Token 只存在于私有运行配置，不入库）
runs/
/runs
*.local.json
# 2026-09-18：赛事当日 Token 文件不再入库（按用户要求只忽略这一类命名）。
# 注意 .gitignore 只对**未跟踪**文件生效：`token/` 下已跟踪的历史凭证不受影响，
# 如需移出跟踪请另行 `git rm --cached <path>`（本次未动）。
token/*测试赛.txt
# 官方下载中断/失败残留（archive_download 先写 .partial 再原子改名；正常均在被忽略的 runs/ 与 artifacts/ 内，此处兜底防止误提交）
*.partial
*.http-error
# 本地代理技能工作区（watchdog 等管线脚本如需团队共享，应提升到 scripts/ 正式入库，而不是提交本目录）
.agents/
# review/ 入库卫生：源码快照与再打包归档不再新增入库（历史已入库文件不受影响；大体积证据走 datasets/ 精选提升）
review/**/*.tar.gz
# 评审过程本地锁文件
review/**/*.lock
# 清理冷却区：待观察期的原始数据暂存（处理完成并验证备份后再移入；冷却期满整目录删除，不入库）
.backup/
.team-work/
# 审计封存包与本地派生数据集（大文件；runs/ 不入库，故本地派生无法由仓库重建）
bundles/
derived/
# 例外：需要共享的统一牌谱训练数据集入库（datasets/derived/）
!datasets/derived/
# 牌谱导出等派生分析产物（可用 scripts/export_game_records.py 从 runs/ 重新生成）
exports/
# 统一本机制品与凭证；迁移须另外复制 artifacts，不能只 git clone。
artifacts/
.private/
# 项目内 DSH 无头通道的 harness home（profile + 会话记录）；含运行痕迹，不入库。
# 生成端 headless 通道用法见 review/llm-guided-heuristic-route-2026-09-15/evidence/3.1-generation/。
.dsh-headless/
# 注：可共享的牌谱/训练制品提交到 datasets/（2026-09-06 起：自由赛完整牌谱）。
# 坐隐面板窗口级缓存：派生大产物（各约 12–13 MB，可由 repro.sh 重建，实测全量重建约 17.2 分钟），
# 按 Lead 裁定不入库；指纹、口径与复跑入口随证据入库。
review/llm-guided-heuristic-route-2026-09-15/evidence/3.6b-panel-triage/panel-cache/
review/llm-guided-heuristic-route-2026-09-15/evidence/3.6b-panel-triage/panel-cache-youcai-true/
# 坐隐 3.6c 评分缓存（可由 repro.sh / sitin_panel_cache.py 重建；92-canonical 227MB 超出 GitHub 单文件 100MB 硬限导致 push 被拒，2026-09-16 起同裁定不入库）
review/llm-guided-heuristic-route-2026-09-15/evidence/3.6c-scorer/raw/*-cache.jsonl
# 大样本封存仍建议走审计线 bundle + exports 流程（大文件不进 Git 的一般原则）。

# 2026-09-18：测试房按房间分目录存放的 4 份 Token 一律不入库（
# 历史已跟踪的 token/ 文件不受影响，如需移出跟踪请另行 git rm --cached）。
token/test_t_*/

# 2026-09-18：R9 验收期间的**运行产物**（账本/面板/样本/运行根）不入库——
# .git 已 1.0GB；这类目录可由 scripts + 冻结输入重建，且体积随运行线性增长。
# 已跟踪的按仓库既有裁定用 git rm --cached 移出（文件保留在磁盘），报告与摘要仍入库并以路径+sha256 引用。
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/*/_runs/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/*/e2e/run-root/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/*/e2e/run-evidence/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/*/probes/_run-*/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/A4-flake/_runs/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P6-a4-seat/mutations/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P9-famcost/red/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P9-famcost/green/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P15-reeval/e2e/run-root/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P15-reeval/e2e/run-evidence/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-fixes/P11-prod/probes/_run-*/
review/llm-guided-heuristic-route-2026-09-15/evidence/v4-impl/r9-gate2/p12/*/sandbox-*/
