  "output_contract": {
    "status_values": [
      "SCORED",
      "ABSTAIN"
    ],
    "scored": "SCORED 必须对输入全部动作恰好各一项（无遗漏/重复/越界键），全部 score 为有限数（布尔冒充数整批失败）；entries 元素必须恰好含 action_key/score/trace 三键。",
    "abstain": "ABSTAIN 时 entries 必须为空（省略、None、() 或 [] 都接受），且必须给出**非空** reason 字符串；ABSTAIN 不得携带评分条目。",
    "reason_three_forms": [
      "SCORED 时 reason 可以**省略**（键不存在）",
      "SCORED 时 reason 可以是 None",
      "SCORED 时 reason 可以是**非空字符串**（用于说明降级/未知锚定）。"
    ],
    "reason_empty_string_rejected": "SCORED 的 reason = \"\"（空字符串）**不接受**：run_scoring_skeleton 抛 ValueError（整个窗口失效，降级到已备紧急计划）。这就是复审 C5 指出的输出侧细则：不是「ABSTAIN/降级原因字符串」一句话能覆盖的。",
    "unknown_is_not_zero": "缺证据动作不得用 0.0 或任何不受下界约束的有限数参与评分；未知必须锚定在全部已知评分之下，或整批 ABSTAIN。",
    "batch_failure": "抛异常、非有限数、布尔冒充数、漏键/重复键/越界键、超工作量限额、缺必需字段任一项即整窗口失效。"
  },
